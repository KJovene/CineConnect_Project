# FICHIER A COPIER POUR AVOIR TES PROPRES VARIABLES D'ENVIRONNEMENT
# A RENOMMER :  .env

# URL de connexion PostgreSQL (utilisée par Drizzle et le backend)
# Exemple pour une base cineconnect sur localhost :
# DATABASE_URL=postgres://postgres:motdepasse@localhost:5432/cineconnect
DATABASE_URL=

# Optionnel: URL dédiée à Drizzle Studio lancée depuis ta machine hôte
# (utile si DATABASE_URL pointe vers l'hôte Docker "postgres")
# DRIZZLE_DATABASE_URL=postgres://postgres:motdepasse@127.0.0.1:5433/cineconnect
DRIZZLE_DATABASE_URL=

# Configuration de l'application
PORT=3000
NODE_ENV=development

# Frontend (pour CORS + cookies)
FRONTEND_ORIGIN=http://localhost:5173

# Better Auth (authentification)
# Générer une clé : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# API omdb
OMDB_API_KEY=
