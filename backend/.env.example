# FICHIER A COPIER VERS backend/.env

# PostgreSQL
# Docker: utilise le service "postgres" sur 5432
DATABASE_URL=postgres://postgres:password@postgres:5432/cineconnect

# Optionnel: utile pour Drizzle depuis l'hote (port expose par docker-compose)
DRIZZLE_DATABASE_URL=postgres://postgres:password@127.0.0.1:5433/cineconnect

# Application
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Better Auth
# Generer une cle: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-secure-random-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# OMDb API (necessaire pour certains seeds)
OMDB_API_KEY=replace-with-your-omdb-api-key
