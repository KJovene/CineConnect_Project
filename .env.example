# Variables d'environnement pour le développement Docker
# Copiez ce fichier vers .env et modifiez les valeurs si nécessaire

# Base de données (automatiquement configuré par Docker)
POSTGRES_DB=cineconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@postgres:5432/cineconnect

# Backend
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=dev-jwt-secret-change-this

# Frontend
VITE_API_URL=http://localhost:3000