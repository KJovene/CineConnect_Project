# Variables d'environnement pour Docker
# Copiez ce fichier vers .env et adaptez les valeurs

# Base de donnees
POSTGRES_DB=cineconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_PORT=5432

# Backend
NODE_ENV=production
BACKEND_PORT=3000
DATABASE_URL=postgresql://postgres:your-secure-password@postgres:5432/cineconnect

# Securite
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Optionnel: base locale de dev (hors Docker)
DEV_DATABASE_URL=postgresql://postgres:password@localhost:5432/cineconnect_dev